ANTHROPIC_API_KEY=replace-with-your-key
ANTHROPIC_BASE_URL=https://your-anthropic-compatible-service
ANTHROPIC_MODEL=your-model-name

REDIS_PASSWORD=replace-with-a-local-password
ORDO_FRONTEND_PORT=5175
ORDO_BACKEND_PORT=18000
ORDO_METRICS_PORT=19090
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
EVAL_BASELINE_PATH=/app/data/eval/baseline.json
ORDO_SKILLS_DIR=/app/skills
ORDO_SKILLS_MAX_PROMPT_CHARS=5000
PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
# Short JSON tasks and final answer synthesis: auto disables thinking only for
# DeepSeek on ModelScope, and deepseek-flash on api.deepseek.com. Other choices:
# default (provider defaults), disabled (explicit provider capability).
ORDO_SHORT_TASK_THINKING=auto
ORDO_MONITOR_MIN_COMPLETED=5

# 可选意图在线向量；不改变RAG模型。local不会发送在线Embedding请求。
INTENT_EMBEDDING_PROVIDER=local
SILICONFLOW_API_KEY=

# 仅本机开发可不配置Token。生产模式必须设置非空、至少24字符Token映射。
# role是接口权限user/admin，与平台admin/member/guest不同。
ORDO_ENV=development
ORDO_API_TOKENS=
MCP_EXTERNAL_ENABLED=false
MCP_SERVERS_CONFIG=/app/config/mcp_servers.json
ORDO_LLM_TIMEOUT_S=15
ORDO_COMPOSER_TIMEOUT_S=8
ORDO_MONITOR_COOLDOWN_SECONDS=60
PROFILE_UPDATE_WORKERS=4
EVAL_JUDGE_TIMEOUT_S=45
EVAL_JUDGE_MAX_TOKENS=4096
